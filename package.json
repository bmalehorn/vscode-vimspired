{
  "name": "vimspired",
  "displayName": "Vimspired",
  "description": "Create your own Vim-inspired keybindings!",
  "version": "6.4.5",
  "publisher": "bmalehorn",
  "engines": {
    "vscode": "^1.125.0"
  },
  "repository": {
    "url": "https://github.com/bmalehorn/vscode-vimspired"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./dist/extension",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Vimspired",
      "properties": {
        "vimspired.keybindings": {
          "type": "object",
          "description": "Keybindings map, key → vscode command",
          "default": {
            "i": "vimspired.toggle"
          }
        },
        "vimspired.insertCursorStyle": {
          "type": "string",
          "enum": [
            "block",
            "block-outline",
            "line",
            "line-thin",
            "underline",
            "underline-thin"
          ],
          "default": "line",
          "description": "Shape of the cursor when in insert mode."
        },
        "vimspired.normalCursorStyle": {
          "type": "string",
          "enum": [
            "block",
            "block-outline",
            "line",
            "line-thin",
            "underline",
            "underline-thin"
          ],
          "default": "block",
          "description": "Shape of the cursor when in normal mode."
        }
      }
    },
    "commands": [
      {
        "command": "vimspired.toggle",
        "title": "Vimspired: toggle normal / insert mode"
      },
      {
        "command": "vimspired.enterNormal",
        "title": "Vimspired: normal mode"
      },
      {
        "command": "vimspired.enterInsert",
        "title": "Vimspired: insert mode"
      }
    ],
    "keybindings": [
      {
        "key": "Escape",
        "command": "vimspired.enterNormal",
        "when": "editorTextFocus"
      }
    ]
  },
  "icon": "images/vimspired.png",
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "compile": "webpack --mode none",
    "watch": "webpack --mode none --watch",
    "package": "vsce package",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vscode-test": "^1.6.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "__metadata": {
    "id": "20b6ea6f-43c5-4004-b393-c237975cbd76",
    "publisherDisplayName": "Brian Malehorn",
    "publisherId": "1215635c-400c-4cc8-96d3-f2d5da4774a4"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  }
}
